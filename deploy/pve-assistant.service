[Unit]
Description=PVE assistant (Telegram + HTTP API, MCP tools)
After=network-online.target
Wants=network-online.target

[Service]
User=assistant
Group=assistant
Environment=PYTHONPATH=/opt/pve-assistant/app
Environment=ASSISTANT_CONFIG=/etc/pve-assistant/config.toml
ExecStart=/opt/pve-assistant/venv/bin/python -u -m pve_assistant serve
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pve-assistant
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
